# Copiare in .env e modificare. Il file .env non va mai salvato nel repository.

# Chiave segreta di Django: generarne una nuova con
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
CONTROLLI_SECRET_KEY=cambiare-questa-chiave

# 1 in sviluppo, 0 in produzione
CONTROLLI_DEBUG=1

# Nomi host ammessi, separati da virgola
CONTROLLI_ALLOWED_HOSTS=127.0.0.1,localhost

# Database PostgreSQL
CONTROLLI_DB_NAME=controlli
CONTROLLI_DB_USER=postgres
CONTROLLI_DB_PASSWORD=
CONTROLLI_DB_HOST=127.0.0.1
CONTROLLI_DB_PORT=5432

# App grafo (facoltativi). Indirizzo con cui gli analisti raggiungono l'applicativo,
# se diverso da quello che il server vede (proxy): serve per i collegamenti alle
# mappe e per l'accesso OAuth della chat.
# CONTROLLI_URL_PUBBLICO=https://controlli.ufficio.example
# Durata dell'accesso OAuth della chat: ore del token, giorni del rinnovo.
# CONTROLLI_OAUTH_ORE_TOKEN=8
# CONTROLLI_OAUTH_GIORNI_RINNOVO=7
